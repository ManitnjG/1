import 'package:hetu_spotube_plugin/hetu_spotube_plugin.dart'

class BrowseEndpoint {
  var client: HttpClient
  var auth: AuthEndpoint

  construct (this.client, this.auth)

  fun sections({ offset: int = 0, limit: int = 10 }) {
    return client.get(
      "/v1/pages/home",
      queryParameters: {
        "sessionId":        auth.sessionId(),
        "token":            "kgsOOmYk3zShYrNP",
        "countryCode":      auth.country(),
        "deviceType":       "PHONE",
        "locale":           "en_US"
      }
    ).then((res) {
      var rows = res.data["rows"] as List
      var sections = rows.map((row) {
        var modules = row["modules"] as List
        if (modules.isEmpty) return null
        var mod = modules[0]
        var title = mod["title"] ?? mod["type"] ?? "Featured"
        var items = _extractItems(mod)
        return {
          "title":    title,
          "subtitle": "",
          "items":    items
        }
      }).where((s) => s != null).toList()

      return {
        "sections": sections,
        "offset":   offset,
        "limit":    limit
      }.toJson()
    })
  }

  // ── helpers ─────────────────────────────────────────────────────────────

  fun _coverUrl(uuid: string, size: int = 320) -> string {
    if (uuid == null || uuid == "") return ""
    return "https://resources.tidal.com/images/${uuid.replaceAll('-','/')}/${size}x${size}.jpg"
  }

  fun _extractItems(mod: Map) -> List {
    var type = mod["type"] ?? ""
    var pagedList = mod["pagedList"]
    if (pagedList == null) return []
    var items = pagedList["items"] as List
    if (items.isEmpty) return []

    var first = items[0]
    if (first["type"] == "track" || first["duration"] != null) {
      return items.map((t) => _mapTrack(t)).toList()
    }
    if (first["numberOfTracks"] != null) {
      return items.map((a) => _mapAlbum(a)).toList()
    }
    return []
  }

  fun _mapTrack(t: Map) -> Map {
    return {
      "id":          t["id"].toString(),
      "name":        t["title"],
      "durationMs":  (t["duration"] as int) * 1000,
      "explicit":    t["explicit"] ?? false,
      "isrc":        t["isrc"] ?? "",
      "trackNumber": t["trackNumber"] ?? 1,
      "artists": [{ "id": t["artist"]["id"].toString(), "name": t["artist"]["name"], "images": [] }],
      "album": {
        "id":     t["album"]["id"].toString(),
        "name":   t["album"]["title"],
        "images": [{ "url": _coverUrl(t["album"]["cover"]), "width": 320, "height": 320 }]
      },
      "images": [{ "url": _coverUrl(t["album"]["cover"]), "width": 320, "height": 320 }]
    }
  }

  fun _mapAlbum(a: Map) -> Map {
    return {
      "id":          a["id"].toString(),
      "name":        a["title"],
      "totalTracks": a["numberOfTracks"] ?? 0,
      "releaseDate": a["releaseDate"] ?? "",
      "artists": [{ "id": a["artist"]["id"].toString(), "name": a["artist"]["name"], "images": [] }],
      "images": [{ "url": _coverUrl(a["cover"], 640), "width": 640, "height": 640 }]
    }
  }
}
